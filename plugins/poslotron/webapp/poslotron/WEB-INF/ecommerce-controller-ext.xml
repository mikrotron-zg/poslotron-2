<!--
    Poslotron extensions for the ecommerce (webshop) webapp controller.

    This file is included from
        plugins/ecommerce/webapp/ecommerce/WEB-INF/controller.xml
    via a single <include/> line, so that all our request- and view-maps
    extending the webshop live here in the plugin (not in core).
-->
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf"
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf https://ofbiz.apache.org/dtds/site-conf.xsd">

    <description>Poslotron extensions to the ecommerce (webshop) controller</description>

    <!--
        Pricelist page (Croatian Trade Act, Art. 12): lists the published
        cjenik archive with public download links. The files themselves are
        generated nightly at 03:00 by the poslotronGeneratePricelist job, not
        on request.
    -->
    <request-map uri="pricelist">
        <security https="false" auth="false"/>
        <response name="success" type="view" value="pricelist"/>
    </request-map>

    <!--
        Public CSV download. Streams a file recorded in the PoslotronPricelist
        archive; response type "none" because the event writes the stream
        itself.
    -->
    <request-map uri="downloadPricelist">
        <security https="false" auth="false"/>
        <event type="groovy"
                path="component://poslotron/src/main/groovy/hr/mikrotron/poslotron/pricelist/DownloadPricelistEvent.groovy"/>
        <response name="success" type="none"/>
        <response name="error" type="none"/>
    </request-map>

    <!-- ===== View maps ===== -->
    <view-map name="pricelist" type="screen" auth="false"
            page="component://poslotron/widget/EcommerceAppExtScreens.xml#pricelist"/>

</site-conf>
