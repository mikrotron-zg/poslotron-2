<?xml version="1.0" encoding="UTF-8"?>
<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Form" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">
    <form name="FindFiscalInvoice" type="single" target="FindFiscalInvoice">
        <field name="noConditionFind"><hidden value="Y"/></field>
        <field name="fiscalInvoiceDate" title="${uiLabelMap.FiscalInvoiceDate}">
            <date-find type="date"/>
        </field>
        <field name="fiscalInvoiceNumber" title="${uiLabelMap.FiscalInvoiceNumber}">
            <text-find/>
        </field>
        <field name="partyId" title="${uiLabelMap.FiscalInvoiceRecipientPartyId}">
            <lookup target-form-name="LookupPartyName" size="15"/>
        </field>
        <field name="fiscalStoreId" title="${uiLabelMap.FiscalStoreId}">
            <drop-down allow-empty="true">
                <entity-options entity-name="FiscalStore" key-field-name="fiscalStoreId" description="${fiscalStoreLabel} [${fiscalStoreId}]">
                    <entity-order-by field-name="fiscalStoreLabel"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="fiscalPaymentTerminalLabel" title="${uiLabelMap.FiscalPaymentTerminalLabel}">
            <text-find/>
        </field>
        <field name="fiscalInvoiceTypeId" title="${uiLabelMap.FiscalInvoiceType}">
            <drop-down allow-empty="true">
                <entity-options entity-name="FiscalInvoiceType" key-field-name="fiscalInvoiceTypeId" description="${description} [${fiscalInvoiceTypeId}]">
                    <entity-order-by field-name="description"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="searchButton" title="${uiLabelMap.CommonFind}" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>
    <form name="FindFiscalInvoicePayment" type="single" target="FindFiscalInvoicePayment">
        <field name="noConditionFind"><hidden value="Y"/></field>
        <field name="fiscalInvoiceDate" title="${uiLabelMap.FiscalInvoiceDate}">
            <date-find type="date"/>
        </field>
        <field name="dateRange" title="${uiLabelMap.FiscalDateRange}">
            <drop-down allow-empty="true">
                <option key="THIS_MONTH" description="${uiLabelMap.FiscalDateRangeThisMonth}"/>
                <option key="LAST_MONTH" description="${uiLabelMap.FiscalDateRangeLastMonth}"/>
                <option key="THIS_YEAR" description="${uiLabelMap.FiscalDateRangeThisYear}"/>
                <option key="LAST_YEAR" description="${uiLabelMap.FiscalDateRangeLastYear}"/>
            </drop-down>
        </field>
        <field name="partyId" title="${uiLabelMap.FiscalInvoiceRecipientPartyId}">
            <lookup target-form-name="LookupPartyName" size="15"/>
        </field>
        <field name="fiscalInvoiceNumber" title="${uiLabelMap.FiscalInvoiceNumber}">
            <text-find/>
        </field>
        <field name="isPayed" title="${uiLabelMap.FiscalIsPayed}">
            <drop-down allow-empty="true" no-current-selected-key="N">
                <option key="Y" description="${uiLabelMap.CommonYes}"/>
                <option key="N" description="${uiLabelMap.CommonNo}"/>
            </drop-down>
        </field>
        <field name="searchButton" title="${uiLabelMap.CommonFind}" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>
    <form name="FiscalReporting" type="single" target="generateFiscalReport">
        <field name="fiscalInvoiceDate" title="${uiLabelMap.FiscalInvoiceDate}">
            <date-find type="date"/>
        </field>
        <field name="dateRange" title="${uiLabelMap.FiscalDateRange}">
            <drop-down allow-empty="true" no-current-selected-key="LAST_MONTH">
                <option key="THIS_MONTH" description="${uiLabelMap.FiscalDateRangeThisMonth}"/>
                <option key="LAST_MONTH" description="${uiLabelMap.FiscalDateRangeLastMonth}"/>
                <option key="THIS_YEAR" description="${uiLabelMap.FiscalDateRangeThisYear}"/>
                <option key="LAST_YEAR" description="${uiLabelMap.FiscalDateRangeLastYear}"/>
            </drop-down>
        </field>
        <field name="fiscalStoreId" title="${uiLabelMap.FiscalStoreId}">
            <drop-down allow-empty="true">
                <entity-options entity-name="FiscalStore" key-field-name="fiscalStoreId" description="${fiscalStoreLabel} [${fiscalStoreId}]">
                    <entity-order-by field-name="fiscalStoreLabel"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="fiscalPaymentTerminalId" title="${uiLabelMap.FiscalPaymentTerminal}">
            <drop-down allow-empty="true">
                <entity-options entity-name="FiscalPaymentTerminal" key-field-name="fiscalPaymentTerminalId" description="${fiscalPaymentTerminalLabel} [${fiscalPaymentTerminalId}]">
                    <entity-order-by field-name="fiscalPaymentTerminalLabel"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="isPayed" title="${uiLabelMap.FiscalIsPayed}">
            <drop-down allow-empty="true">
                <option key="Y" description="${uiLabelMap.CommonYes}"/>
                <option key="N" description="${uiLabelMap.CommonNo}"/>
            </drop-down>
        </field>
        <field name="exportFormat" title="${uiLabelMap.FiscalReportingExportFormat}"
                event="onchange" action="document.querySelector('[name=csvDelimiter]').disabled=(this.value!=='CSV');">
            <drop-down no-current-selected-key="CSV">
                <option key="CSV" description="CSV"/>
                <option key="PDF" description="PDF"/>
            </drop-down>
        </field>
        <field name="csvDelimiter" title="${uiLabelMap.FiscalReportingCsvDelimiter}"
                disabled="${groovy: 'PDF'.equals(parameters.exportFormat) ? 'true' : 'false'}">
            <text size="1" maxlength="1" default-value=";"/>
        </field>
        <field name="generateButton" title="${uiLabelMap.FiscalReportingGenerate}" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>
    <grid name="ListFiscalInvoicePayment" list-name="listIt" target="updateFiscalInvoiceIsPayed" paginate-target="FindFiscalInvoicePayment" default-entity-name="FiscalInvoiceSearchView"
        separate-columns="true"
        odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar"
        empty-form-data-message="${uiLabelMap.CommonNoRecordFound}">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="paymentSearchFields"/>
                <field-map field-name="entityName" value="FiscalInvoiceSearchView"/>
                <field-map field-name="orderBy" value="-fiscalInvoiceDate"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
        </actions>
        <row-actions>
            <service service-name="getPartyNameForDate" result-map="partyNameFrom">
                <field-map field-name="partyId" from-field="partyIdFrom"/>
                <field-map field-name="compareDate" from-field="fiscalInvoiceDate"/>
                <field-map field-name="lastNameFirst" value="Y"/>
            </service>
            <service service-name="getPartyNameForDate" result-map="partyNameTo">
                <field-map field-name="partyId" from-field="partyId"/>
                <field-map field-name="compareDate" from-field="fiscalInvoiceDate"/>
                <field-map field-name="lastNameFirst" value="Y"/>
            </service>
        </row-actions>
        <field name="fiscalInvoiceNumber" title="${uiLabelMap.FiscalInvoiceNumber}" sort-field="true" widget-style="buttontext">
            <hyperlink description="${fiscalInvoiceNumber}" target="/fiscal/control/fiscalinvoiceview" target-type="inter-app">
                <parameter param-name="fiscalInvoiceId"/>
            </hyperlink>
        </field>
        <field name="orderId" title="${uiLabelMap.OrderOrderId}" sort-field="true" widget-style="buttontext" widget-area-style="align-center" title-area-style="align-center">
            <hyperlink description="${orderId}" target="/ordermgr/control/orderview" target-type="inter-app">
                <parameter param-name="orderId"/>
            </hyperlink>
        </field>
        <field name="partyIdFrom" title="${uiLabelMap.FiscalInvoiceIssuer}" sort-field="true">
            <display description="${partyNameFrom.fullName} [${partyIdFrom}]"/>
        </field>
        <field name="partyIdTo" title="${uiLabelMap.FiscalInvoiceRecipientPartyId}" entry-name="partyId" sort-field="true">
            <hyperlink description="${partyNameTo.fullName} [${partyId}]" target="/partymgr/control/viewprofile" target-type="inter-app">
                <parameter param-name="partyId"/>
            </hyperlink>
        </field>
        <field name="fiscalInvoiceDate" title="${uiLabelMap.FiscalInvoiceDate}" sort-field="true" widget-area-style="align-center" title-area-style="align-center"><display type="date"/></field>
        <field name="amount" title="${uiLabelMap.CommonAmount}" sort-field="true" widget-area-style="align-right" title-area-style="align-right"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="isPayed" title="${uiLabelMap.FiscalIsPayed}" widget-area-style="align-center" title-area-style="align-center">
            <check>
                <option key="Y" description=" "/>
            </check>
        </field>
        <field name="poNumber" title="${uiLabelMap.FiscalPoNumber}"><display/></field>
        <field name="fiscalInvoiceId"><hidden/></field>
        <field name="submitButton" title="${uiLabelMap.CommonUpdate}" widget-style="smallSubmit"><submit button-type="button"/></field>
    </grid>
    <grid name="ListFiscalInvoice" list-name="listIt" paginate-target="FindFiscalInvoice" default-entity-name="FiscalInvoiceSearchView"
        odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar"
        form-title-area-style="align-center"
        empty-form-data-message="${uiLabelMap.CommonNoRecordFound}">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="parameters"/>
                <field-map field-name="entityName" value="FiscalInvoiceSearchView"/>
                <field-map field-name="orderBy" value="-fiscalInvoiceDate"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
        </actions>
        <row-actions>
            <service service-name="getPartyNameForDate" result-map="partyNameFrom">
                <field-map field-name="partyId" from-field="partyIdFrom"/>
                <field-map field-name="compareDate" from-field="fiscalInvoiceDate"/>
                <field-map field-name="lastNameFirst" value="Y"/>
            </service>
            <service service-name="getPartyNameForDate" result-map="partyNameTo">
                <field-map field-name="partyId" from-field="partyId"/>
                <field-map field-name="compareDate" from-field="fiscalInvoiceDate"/>
                <field-map field-name="lastNameFirst" value="Y"/>
            </service>
        </row-actions>
        <field name="fiscalInvoiceNumber" title="${uiLabelMap.FiscalInvoiceNumber}" sort-field="true" widget-style="buttontext">
            <hyperlink description="${fiscalInvoiceNumber}" target="/fiscal/control/fiscalinvoiceview" target-type="inter-app">
                <parameter param-name="fiscalInvoiceId"/>
            </hyperlink>
        </field>
        <field name="orderId" title="${uiLabelMap.OrderOrderId}" sort-field="true" widget-style="buttontext" widget-area-style="align-center" title-area-style="align-center">
            <hyperlink description="${orderId}" target="/ordermgr/control/orderview" target-type="inter-app">
                <parameter param-name="orderId"/>
            </hyperlink>
        </field>
        <field name="partyIdFrom" title="${uiLabelMap.FiscalInvoiceIssuer}" sort-field="true">
            <display description="${partyNameFrom.fullName} [${partyIdFrom}]"/>
        </field>
        <field name="partyIdTo" title="${uiLabelMap.FiscalInvoiceRecipientPartyId}" entry-name="partyId" sort-field="true">
            <hyperlink description="${partyNameTo.fullName} [${partyId}]" target="/partymgr/control/viewprofile" target-type="inter-app">
                <parameter param-name="partyId"/>
            </hyperlink>
        </field>
        <field name="fiscalInvoiceDate" title="${uiLabelMap.FiscalInvoiceDate}" sort-field="true" widget-area-style="align-center" title-area-style="align-center"><display type="date"/></field>
        <field name="amount" title="${uiLabelMap.CommonAmount}" sort-field="true" widget-area-style="align-right" title-area-style="align-right"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="isPayed" title="${uiLabelMap.FiscalIsPayed}" disabled="true" widget-area-style="align-center" title-area-style="align-center">
            <check>
                <option key="Y" description=" "/>
            </check>
        </field>
        <field name="poNumber" title="${uiLabelMap.FiscalPoNumber}"><display/></field>
    </grid>
    <form name="FiscalInvoiceHeader" type="single" default-map-name="fiscalInvoice" default-entity-name="FiscalInvoice"
            odd-row-style="alternate-row" default-table-style="basic-table">
        <field name="fiscalInvoiceNumber" title="${uiLabelMap.FiscalInvoiceNumber}"><display/></field>
        <field name="fiscalInvoiceId" title="Id"><display/></field>
        <field name="fiscalInvoiceDate" title="${uiLabelMap.FiscalInvoiceDate}"><display type="date"/></field>
        <field name="amount" title="${uiLabelMap.CommonAmount}"><display type="currency" currency="${invoice.currencyUomId}"/></field>
        <field name="isPayed" title="${uiLabelMap.FiscalIsPayed}"><display description="${fiscalInvoice.isPayed == 'Y' ? uiLabelMap.CommonYes : uiLabelMap.CommonNo}"/></field>
        <field name="poNumber" title="${uiLabelMap.FiscalPoNumber}"><display/></field>
        <field name="invoiceId" title="${uiLabelMap.OrderReceipt}" widget-style="buttontext">
            <hyperlink description="${fiscalInvoice.invoiceId}" target="/accounting/control/viewInvoice" target-type="inter-app">
                <parameter param-name="invoiceId" from-field="fiscalInvoice.invoiceId"/>
            </hyperlink>
        </field>
        <field name="orderId" title="${uiLabelMap.OrderOrderId}" widget-style="buttontext">
            <hyperlink description="${fiscalInvoice.orderId}" target="/ordermgr/control/orderview" target-type="inter-app">
                <parameter param-name="orderId" from-field="fiscalInvoice.orderId"/>
            </hyperlink>
        </field>
        <field name="fiscalPaymentTerminalId" title="${uiLabelMap.FiscalPaymentTerminal}"><display description="${fiscalPaymentTerminal.fiscalPaymentTerminalLabel} [${fiscalInvoice.fiscalPaymentTerminalId}]"/></field>
        <field name="fiscalStoreId" title="${uiLabelMap.FiscalStoreId}"><display description="${fiscalStore.fiscalStoreLabel} [${fiscalStore.fiscalStoreId}]"/></field>
        <field name="fiscalInvoiceIdExternal" title="${uiLabelMap.FiscalInvoiceIdExternal}"><display/></field>
        <field name="fiscalInvoicePdfExternal" title="${uiLabelMap.FiscalInvoicePdfExternal}" widget-style="buttontext">
            <hyperlink description="PDF" target="${fiscalInvoice.fiscalInvoicePdfExternal}" target-type="plain-url" target-window="_blank"/>
        </field>
        <field name="zki" title="${uiLabelMap.FiscalZki}"><display/></field>
        <field name="jir" title="${uiLabelMap.FiscalJir}"><display/></field>
    </form>
    <grid name="ListFiscalInvoiceItems" list-name="invItemAndOrdItems" paginate-target="fiscalinvoiceview"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar"
            separate-columns="true">
        <row-actions>
            <set field="quantity" value="${groovy: quantity ?: 1}" type="BigDecimal"/>
            <set field="total" value="${groovy: (quantity ?: 0) * (amount ?: 0)}" type="BigDecimal"/>
        </row-actions>
        <auto-fields-entity entity-name="InvItemAndOrdItem" default-field-type="display"/>
        <field name="invoiceId"><hidden/></field>
        <field name="invoiceItemSeqId"><display/></field>
        <field name="invoiceItemTypeId"><display-entity entity-name="InvoiceItemType"/></field>
        <field name="orderId" widget-style="buttontext">
            <hyperlink description="${orderId}" target="/ordermgr/control/orderview" target-type="inter-app">
                <parameter param-name="orderId"/>
            </hyperlink>
        </field>
        <field name="productId" widget-style="buttontext">
            <hyperlink description="${productId}" target="/catalog/control/EditProduct" target-type="inter-app">
                <parameter param-name="productId"/>
            </hyperlink>
        </field>
        <field name="quantity" widget-area-style="align-text"><display/></field>
        <field name="amount" title="${uiLabelMap.AccountingUnitPrice}" widget-area-style="align-text"><display type="currency" currency="${invoice.currencyUomId}"/></field>
        <field name="total"><display type="currency" currency="${invoice.currencyUomId}"/></field>
    </grid>
    <grid name="ListFiscalServiceApiRequests" list-name="fiscalServiceApiRequests" paginate-target="fiscalinvoiceview"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="fiscalServiceApiRequestId"><display/></field>
        <field name="fiscalServiceApiId"><display/></field>
        <field name="invoiceId"><display/></field>
        <field name="requestRawText" title="${uiLabelMap.FiscalApiRequestRawText}"><display/></field>
    </grid>
    <grid name="ListFiscalServiceApiResponses" list-name="fiscalServiceApiResponses" paginate-target="fiscalinvoiceview"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="fiscalServiceApiResponseId"><display/></field>
        <field name="fiscalServiceApiRequestId"><display/></field>
        <field name="status" title="${uiLabelMap.FiscalApiResponseStatus}"><display/></field>
        <field name="responseRawText" title="${uiLabelMap.FiscalApiResponseRawText}"><display/></field>
    </grid>
</forms>
